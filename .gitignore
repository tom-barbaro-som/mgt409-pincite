# Secrets: never commit keys. Use .env.example as the template.
.env
*.env
!.env.example
Portkey.env

# Python
.venv/
__pycache__/
*.pyc

# Built / downloaded data (rebuilt by scripts/build_index.py)
data/index_*.db
data/index_*.db-wal
data/index_*.db-shm
data/full/
data/cache/
output/evals/*.log
# Per-question artifacts, regenerated by every run (the report embeds the screenshots it uses)
output/briefs/
output/evidence/
output/safety/index.db*

# Node (frontend/dist IS committed so the dashboard runs without Node)
frontend/node_modules/
*.tsbuildinfo

# Local tooling and OS files
.claude/
.DS_Store
