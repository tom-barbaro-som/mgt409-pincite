# Copy this file to .env and fill in your key. The app looks for .env in this
# folder first, then one folder up. .env is git-ignored: never commit a real key.
#   cp .env.example .env

# Portkey gateway key used for every agent call (OpenAI-compatible Responses API)
PORTKEY_API_KEY=your-portkey-api-key-here

# The only model the course key allows
OPENAI_MODEL=gpt-6-luna

# Dataset: sample (default; small, works offline) or full (entire CRS index + GAO RSS;
# build it first with: python scripts/build_index.py --dataset full --download)
DATASET=sample

# Optional
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=            # leave empty if your key has a default provider attached
# OPENAI_REASONING_EFFORT=low
# CASE_TOKEN_BUDGET=250000     # all agents, one research request
# MAX_PAGES_READ=16            # hard per-case page budget enforced by the MCP server
